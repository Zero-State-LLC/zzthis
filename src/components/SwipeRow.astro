---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div class="swipe" data-swipe>
  <div
    class="swipe__viewport"
    role="region"
    aria-label={label}
    tabindex="0"
    data-swipe-viewport
  >
    <ul class="swipe__track" data-swipe-track>
      <slot />
    </ul>
  </div>
  <div class="swipe__controls" data-swipe-controls hidden>
    <button
      type="button"
      class="btn btn--secondary"
      data-swipe-prev
      aria-disabled="true"
    >
      Previous
    </button>
    <button type="button" class="btn btn--secondary" data-swipe-next>
      Next
    </button>
  </div>
</div>

<script is:inline>
  document.querySelectorAll("[data-swipe]").forEach((root) => {
    const viewport = root.querySelector("[data-swipe-viewport]");
    const track = root.querySelector("[data-swipe-track]");
    const prev = root.querySelector("[data-swipe-prev]");
    const next = root.querySelector("[data-swipe-next]");
    const controls = root.querySelector("[data-swipe-controls]");
    if (!viewport || !track || !prev || !next || !controls) return;
    const step = () => {
      const item = track.querySelector("li");
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return item
        ? item.getBoundingClientRect().width + gap
        : viewport.clientWidth;
    };
    const update = () => {
      const max = viewport.scrollWidth - viewport.clientWidth - 1;
      prev.setAttribute("aria-disabled", String(viewport.scrollLeft <= 0));
      next.setAttribute("aria-disabled", String(viewport.scrollLeft >= max));
    };
    const move = (direction, button) => {
      if (button.getAttribute("aria-disabled") === "true") return;
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      viewport.scrollBy({
        left: direction * step(),
        behavior: reduce ? "auto" : "smooth",
      });
    };
    prev.addEventListener("click", () => move(-1, prev));
    next.addEventListener("click", () => move(1, next));
    viewport.addEventListener("scroll", update, { passive: true });
    controls.hidden = false;
    update();
  });
</script>

<style>
  .swipe__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    padding-bottom: var(--s-5);
  }

  .swipe__track {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 85%;
    gap: var(--s-4);
  }

  .swipe__track > :global(li) {
    min-width: 0;
    scroll-snap-align: start;
  }

  .swipe__controls {
    display: flex;
    gap: var(--s-3);
  }

  @media (min-width: 600px) {
    .swipe__viewport {
      overflow: visible;
      padding-bottom: 0;
    }

    .swipe__track {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
      gap: var(--s-5);
    }

    .swipe__controls {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .swipe__track {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
