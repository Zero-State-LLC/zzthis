---
import { conceptLabels } from "../content/labels";
import { images } from "../content/images";
import { url } from "../lib/url";
import {
  coreIdentity,
  decisionBands,
  howItWorksPage,
} from "../content/workflows";
---

<section class="tour" id="how-it-works" aria-labelledby="how-title">
  <div class="tour__head">
    <h2 id="how-title">{coreIdentity.heading}</h2>
    <p>{coreIdentity.intro}</p>
    <p class="label">{conceptLabels.group}</p>
  </div>
  <ol class="frames">
    {coreIdentity.steps.map((step) => {
      const image = images[step.image];
      return (
        <li class="frame">
          <img
            src={url(image.src)}
            width={image.width}
            height={image.height}
            loading="lazy"
            decoding="async"
            alt={image.alt}
          />
          <div class="frame__cap">
            <span class="frame__n">{step.numeral}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      );
    })}
  </ol>
  <div class="tour__foot">
    <p>
      <span class="k">{coreIdentity.exampleLabel}</span>{" "}
      <code>{coreIdentity.exampleCode}</code>
    </p>
    <p>{coreIdentity.closing}</p>
    <p>
      <a class="arrow" href={url("demo")}>
        {coreIdentity.demoLinkText}
      </a>
    </p>
  </div>
  <div class="notes">
    <article class="notecard">
      <h3>{howItWorksPage.uncertain.heading}</h3>
      <p>{howItWorksPage.uncertain.text}</p>
      <ol class="bands" aria-label={decisionBands.ariaLabel}>
        {decisionBands.names.map((name) => (
          <li class:list={{ "is-accept": name === "Resolve" }}>{name}</li>
        ))}
      </ol>
      <p class="label">{decisionBands.note}</p>
    </article>
    <article class="notecard">
      <h3>{howItWorksPage.publicRecord.heading}</h3>
      <p>{howItWorksPage.publicRecord.text}</p>
    </article>
  </div>
</section>
