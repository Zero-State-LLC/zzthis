---
import {
  comparisonColumns,
  comparisonHeading,
  comparisonNote,
  comparisonRows,
} from "../content/comparison";
---

<div class="comparison">
  <ul class="comparison__cards" aria-hidden="true">
    {comparisonColumns.map((column) => (
      <li>
        <div class:list={["mount", { "mount--accent": column.accent }]}>
          <div class="mount__shadow" />
          <div class="mount__edge">
            <div class="mount__body comparison__body">
              <p class="comparison__name">{column.name}</p>
              <dl class="comparison__rows">
                {comparisonRows.map((row) => (
                  <div class="comparison__row">
                    <dt class="eyebrow">{row.label}</dt>
                    <dd>{column.cells[row.key]}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        </div>
      </li>
    ))}
  </ul>
  <div class="visually-hidden">
    <table>
      <caption>{comparisonHeading}</caption>
      <thead>
        <tr>
          <td></td>
          {comparisonColumns.map((column) => (
            <th scope="col">{column.name}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {comparisonRows.map((row) => (
          <tr>
            <th scope="row">{row.label}</th>
            {comparisonColumns.map((column) => (
              <td>{column.cells[row.key]}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="caption comparison__note">{comparisonNote}</p>
</div>

<style>
  .comparison__cards {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-5);
  }

  .comparison__cards > li {
    min-width: 0;
  }

  .comparison__note {
    max-width: none;
    margin-block-start: var(--s-4);
  }

  @media (min-width: 600px) {
    .comparison__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
    }
  }

  .comparison__body {
    gap: var(--s-4);
    padding: var(--s-5) var(--s-4);
  }

  .comparison__name {
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.3;
  }

  .comparison__rows {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .comparison__row {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
    padding-top: var(--s-3);
    border-top: 1px solid var(--edge);
  }

  .comparison__row dd {
    margin: 0;
  }

  @media (min-width: 900px) {
    .comparison__cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--s-5);
      row-gap: 0;
    }

    .comparison__cards > li,
    .comparison__cards > li > .mount,
    .comparison__cards .mount__edge,
    .comparison__body,
    .comparison__rows {
      display: grid;
      grid-template-rows: subgrid;
      height: auto;
    }

    .comparison__cards > li,
    .comparison__cards > li > .mount,
    .comparison__cards .mount__edge,
    .comparison__body {
      grid-row: span 5;
    }

    .comparison__rows {
      display: grid;
      grid-row: span 4;
    }

    .comparison__name {
      padding-block-end: var(--s-4);
    }
  }
</style>
