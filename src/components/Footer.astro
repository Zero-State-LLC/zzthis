---
import {
  contactEmail,
  footerItems,
  footerNote,
  footerNotice,
  zzthatSocial,
  zzthisSocial,
} from "../content/navigation";
import type { SocialIcon } from "../content/navigation";
import { zzthatLogo } from "../content/contact";
import { url } from "../lib/url";

// Brand glyphs drawn inline (no third-party requests), 24-unit grid.
const glyphs: Record<SocialIcon, string> = {
  x: '<path fill="currentColor" d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.93zm-1.29 19.5h2.04L6.49 3.24H4.3z"/>',
  discord:
    '<path fill="currentColor" d="M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.07.07 0 0 0-.08.04c-.21.38-.44.87-.6 1.25a18.27 18.27 0 0 0-5.49 0 12.64 12.64 0 0 0-.62-1.25.08.08 0 0 0-.08-.04 19.74 19.74 0 0 0-4.88 1.52.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.06 19.9 19.9 0 0 0 5.99 3.03.08.08 0 0 0 .09-.03c.46-.63.87-1.3 1.22-1.99a.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.89.08.08 0 0 1-.01-.13l.37-.29a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.06 0a.07.07 0 0 1 .08.01l.37.29a.08.08 0 0 1-.01.13 12.3 12.3 0 0 1-1.87.89.08.08 0 0 0-.04.11c.36.7.77 1.36 1.22 1.99a.08.08 0 0 0 .09.03 19.84 19.84 0 0 0 6-3.03.08.08 0 0 0 .03-.06c.5-5.18-.84-9.67-3.55-13.66a.06.06 0 0 0-.03-.03zM8.02 15.33c-1.18 0-2.16-1.09-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.33-.96 2.42-2.16 2.42zm7.97 0c-1.18 0-2.15-1.09-2.15-2.42 0-1.33.95-2.42 2.15-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.33-.95 2.42-2.16 2.42z"/>',
  instagram:
    '<rect x="2.5" y="2.5" width="19" height="19" rx="5.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.6" cy="6.4" r="1.3" fill="currentColor"/>',
};
---

<footer class="colophon">
  <nav aria-label="Footer">
    {footerItems.map((item) => (
      <a href={url(item.path)}>{item.label}</a>
    ))}
  </nav>
  <div class="colophon__social">
    <ul class="social" aria-label="zzThis social links">
      {zzthisSocial.map((link) => (
        <li>
          <a href={link.href} aria-label={link.label} title={link.label}>
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              set:html={glyphs[link.icon]}
            />
          </a>
        </li>
      ))}
    </ul>
    {zzthatSocial.length > 0 && (
      <ul class="social social--zzthat" aria-label="zzThat social links">
        <li class="social__brand">
          <img
            src={url(zzthatLogo.src)}
            width={zzthatLogo.width}
            height={zzthatLogo.height}
            alt={zzthatLogo.alt}
            loading="lazy"
            decoding="async"
          />
        </li>
        {zzthatSocial.map((link) => (
          <li>
            <a href={link.href} aria-label={link.label} title={link.label}>
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                set:html={glyphs[link.icon]}
              />
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
  <p>
    zzThis. Contact: <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.{" "}
    {footerNotice}. {footerNote}
  </p>
</footer>
