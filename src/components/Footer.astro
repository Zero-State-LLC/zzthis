---
import {
  contactEmail,
  footerItems,
  footerNote,
  footerNotice,
} from "../content/navigation";
import { url } from "../lib/url";
---

<footer class="colophon">
  <nav aria-label="Footer">
    {footerItems.map((item) => (
      <a href={url(item.path)}>{item.label}</a>
    ))}
  </nav>
  <p>
    zzThis. Contact: <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.{" "}
    {footerNotice}. {footerNote}
  </p>
</footer>
