---
import { images } from "../content/images";
import { conceptLabels } from "../content/labels";
import { url } from "../lib/url";
import { fieldLogistics } from "../content/workflows";

function captionFor(title: string, caption: string): string {
  if (caption === "" || caption === title || caption === `${title}.`) return "";
  return caption;
}
---

<section class="field" id="field-logistics" aria-labelledby="field-title">
  <div class="field__head">
    <h2 id="field-title">{fieldLogistics.heading}</h2>
    <p>{fieldLogistics.intro}</p>
    <p class="label">{conceptLabels.group}</p>
  </div>
  <ul
    class="field__frames"
    tabindex="0"
    aria-label={fieldLogistics.regionLabel}
  >
    {fieldLogistics.images.map((id) => {
      const image = images[id];
      const caption = captionFor(image.title, image.caption);
      return (
        <li>
          <img
            src={url(image.src)}
            width={image.width}
            height={image.height}
            loading="lazy"
            decoding="async"
            alt={image.alt}
          />
          <p>
            <b>{image.title}</b>
            {caption && ` ${caption}`}
          </p>
        </li>
      );
    })}
  </ul>
</section>
