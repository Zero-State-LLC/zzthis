---
import { conceptLabels } from "../content/labels";

interface Props {
  text?: string;
}

const { text = conceptLabels.page } = Astro.props;
---

<p class="concept-label" role="note">
  <span class="regmark" aria-hidden="true"></span>
  <span>{text}</span>
</p>

<style>
  .concept-label {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    max-width: none;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-muted);
  }
</style>
