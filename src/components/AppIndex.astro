---
import { applicationsHome } from "../content/applications";
import { homeAppEntries } from "../content/homeApps";
import { conceptLabels } from "../content/labels";
import { url } from "../lib/url";

const entries = homeAppEntries();
---

<section class="apps" id="applications" aria-labelledby="apps-title">
  <h2 id="apps-title">{applicationsHome.heading}</h2>
  <p>{applicationsHome.intro}</p>
  <ul class="apps__list">
    {entries.map((entry) => (
      <li
        class:list={[
          "app",
          {
            "app--wide-only": entry.wideOnly,
            "app--pair": entry.images.length > 1,
          },
        ]}
        style={`--shots: ${entry.images.length}`}
      >
        <div class="app__media">
          {entry.images.map((image) => (
            <img
              src={url(image.src)}
              width={image.width}
              height={image.height}
              loading="lazy"
              decoding="async"
              alt={image.alt}
            />
          ))}
        </div>
        <div>
          <span class="tag">{conceptLabels.standalone}</span>
          <h3>
            <a href={url(`applications#${entry.id}`)}>{entry.title}</a>
          </h3>
          <p>{entry.story}</p>
        </div>
      </li>
    ))}
  </ul>
  <p>
    <a class="arrow" href={url("applications")}>
      {applicationsHome.linkText}
    </a>
  </p>
</section>
