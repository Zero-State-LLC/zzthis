---
import ThemeToggle from "./ThemeToggle.astro";
import { consoleCopy } from "../content/console";
import { images } from "../content/images";
import { navItems, type NavKey } from "../content/navigation";
import { url } from "../lib/url";

interface Props {
  current?: NavKey | undefined;
  home?: boolean | undefined;
}

const { current, home = false } = Astro.props;
const light = images["logo-light"];
const dark = images["logo-dark"];
---

<header class="nav">
  <a class="nav__mark" href={url("")} aria-label="zzThis home">
    <img
      class="only-dark"
      src={url(dark.src)}
      width={dark.width}
      height={dark.height}
      alt=""
    />
    <img
      class="only-light"
      src={url(light.src)}
      width={light.width}
      height={light.height}
      alt=""
    />
  </a>
  {home ? (
    <button
      class="pill"
      type="button"
      data-pill
      aria-label={consoleCopy.pillLabel}
    >
      <span class="pill__code">{consoleCopy.pillCode}</span>
      <span class="pill__text">{consoleCopy.pillText}</span>
      <kbd>/</kbd>
    </button>
  ) : (
    <a
      class="pill"
      href={url("#lookup")}
      aria-label={consoleCopy.pillAwayLabel}
    >
      <span class="pill__code">{consoleCopy.pillCode}</span>
      <span class="pill__text">{consoleCopy.pillText}</span>
      <kbd>/</kbd>
    </a>
  )}
  <nav class="nav__links" id="nav" aria-label="Main">
    {navItems.map((item) => (
      <a
        href={url(item.path)}
        aria-current={current === item.key ? "page" : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
  <button
    class="nav__menu"
    type="button"
    aria-expanded="false"
    aria-controls="nav"
    data-menu
  >
    Menu
  </button>
  <ThemeToggle />
</header>

<script is:inline>
  (() => {
    const menu = document.querySelector("[data-menu]");
    const nav = document.getElementById("nav");
    if (!(menu instanceof HTMLButtonElement) || !nav) return;
    menu.addEventListener("click", () => {
      const open = menu.getAttribute("aria-expanded") !== "true";
      menu.setAttribute("aria-expanded", String(open));
      nav.classList.toggle("is-open", open);
    });
    nav.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (
        target.closest("a") &&
        menu.getAttribute("aria-expanded") === "true"
      ) {
        menu.click();
      }
    });
  })();
</script>
