---
import ThemeToggle from "./ThemeToggle.astro";
import { navItems, type NavKey } from "../content/navigation";
import { images } from "../content/images";
import { url } from "../lib/url";

interface Props {
  current?: NavKey | undefined;
}

const { current } = Astro.props;
const light = images["logo-light"];
const dark = images["logo-dark"];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href={url("")}>
      <span class="visually-hidden">zzThis</span>
      <img
        class="theme-light-only"
        src={url(light.src)}
        width={light.width}
        height={light.height}
        alt=""
        aria-hidden="true"
      />
      <img
        class="theme-dark-only"
        src={url(dark.src)}
        width={dark.width}
        height={dark.height}
        alt=""
        aria-hidden="true"
      />
    </a>
    <div class="header-tools">
      <ThemeToggle />
      <button
        class="btn btn--secondary menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        data-menu-button
        hidden
      >
        Menu
      </button>
    </div>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={url(item.path)}
              aria-current={current === item.key ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const button = document.querySelector("[data-menu-button]");
    const nav = document.getElementById("site-nav");
    if (!button || !nav) return;
    button.hidden = false;
    nav.dataset.collapsible = "true";
    button.addEventListener("click", () => {
      const open = button.getAttribute("aria-expanded") !== "true";
      button.setAttribute("aria-expanded", String(open));
      nav.dataset.open = String(open);
    });
  })();
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--edge);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-5);
    padding-block: var(--s-3);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-inline-end: auto;
  }

  .logo img {
    width: auto;
    height: 30px;
  }

  .header-tools {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .site-nav {
    flex-basis: 100%;
  }

  .nav-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-5);
  }

  .nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration-color: transparent;
  }

  .nav-list a:hover,
  .nav-list a[aria-current="page"] {
    text-decoration-color: var(--accent);
  }

  @media (max-width: 899.98px) {
    .site-nav[data-collapsible="true"]:not([data-open="true"]) {
      display: none;
    }

    .site-nav[data-collapsible="true"] .nav-list {
      flex-direction: column;
      padding-block: var(--s-3);
    }
  }

  @media (min-width: 900px) {
    .header-inner {
      flex-wrap: nowrap;
    }

    .site-nav {
      flex-basis: auto;
      order: 1;
    }

    .header-tools {
      order: 2;
    }

    .menu-btn {
      display: none !important;
    }
  }
</style>
