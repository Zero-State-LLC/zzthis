---
import { topWays } from "../content/uses";
---

<div class="top-ways">
  <h3 class="top-ways__heading">{topWays.heading}</h3>
  <ol class="top-ways__grid">
    {topWays.items.map((item) => (
      <li>
        <div class="mount">
          <div class="mount__shadow" aria-hidden="true" />
          <div class="mount__edge">
            <div class="mount__body top-ways__body">
              <span class="top-ways__numeral" aria-hidden="true">
                {item.numeral}
              </span>
              <h4>{item.title}</h4>
              <p class="top-ways__status">{item.status}</p>
              <ul class="top-ways__codes">
                {item.codes.map((code) => (
                  <li>
                    <code class="code">{code}</code>
                  </li>
                ))}
              </ul>
              <p>{item.text}</p>
            </div>
          </div>
        </div>
      </li>
    ))}
  </ol>
</div>

<style>
  .top-ways__heading {
    padding-block-start: var(--s-4);
    border-top: 1px solid var(--edge);
  }

  .top-ways__grid {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-5);
    margin-block-start: var(--s-4);
  }

  .top-ways__grid > li {
    min-width: 0;
  }

  .top-ways__body {
    gap: var(--s-3);
    padding: var(--s-4) var(--s-4) var(--s-5);
  }

  .top-ways__numeral {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  .top-ways__numeral::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-inline-end: var(--s-2);
    vertical-align: middle;
    background: var(--accent);
  }

  .top-ways__status {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-label);
    font-weight: 600;
  }

  .top-ways__codes {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .top-ways__codes .code {
    overflow-wrap: anywhere;
  }

  .top-ways__body > p:not(.top-ways__status) {
    margin-block-start: auto;
  }

  @media (min-width: 600px) {
    .top-ways__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 1fr;
    }
  }

  @media (min-width: 900px) {
    .top-ways__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
