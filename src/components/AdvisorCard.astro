---
import type { Person } from "../content/people";

interface Props {
  person: Person;
}

const { person } = Astro.props;
const future = person.initials === undefined;
---

{future ? (
  <div class="advisor advisor--future">
    <div class="advisor__tile advisor__tile--future" aria-hidden="true" />
    <div class="advisor__text">
      <h3>{person.name}</h3>
      <p class="caption">{person.role}</p>
    </div>
  </div>
) : (
  <div class="mount">
    <div class="mount__shadow" aria-hidden="true" />
    <div class="mount__edge">
      <div class="mount__body">
        <div class="advisor__tile" aria-hidden="true">
          <span>{person.initials}</span>
        </div>
        <div class="advisor__text">
          <h3>{person.name}</h3>
          <p class="caption">{person.role}</p>
          {person.profileUrl && (
            <a
              class="advisor__link"
              href={person.profileUrl}
              aria-label={`LinkedIn profile for ${person.name}`}
            >
              LinkedIn
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
)}

<style>
  .advisor__tile {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    max-height: 220px;
    border-bottom: 1px solid var(--edge);
    font-family: var(--font-mono);
    font-size: 42px;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .advisor__tile--future {
    border-bottom: 1px dashed var(--edge);
  }

  .advisor__text {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-4) var(--s-4) var(--s-5);
  }

  .advisor__link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .advisor--future {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px dashed var(--text-muted);
  }
</style>
