---
import { applications, applicationsHome } from "../content/applications";
import { images } from "../content/images";
import { objectPosition } from "../lib/image";
import { url } from "../lib/url";
---

<div class="apps">
  <ul class="apps__grid">
    {applications.map((app) => (
      <li class:list={{ "apps__item--wide-only": app.homeWideOnly }}>
        <div class="mount">
          <div class="mount__shadow" aria-hidden="true" />
          <div class="mount__edge">
            <div class="mount__body apps__body">
              <div
                class="apps__media"
                style={`grid-template-columns: repeat(${app.homeImages.length}, minmax(0, 1fr))`}
              >
                {app.homeImages.map((id) => (
                  <img
                    src={url(images[id].src)}
                    width={images[id].width}
                    height={images[id].height}
                    alt={images[id].alt}
                    loading="lazy"
                    decoding="async"
                    style={`object-position: ${objectPosition(images[id].focal)}`}
                  />
                ))}
              </div>
              <div class="apps__text">
                <h3>{app.title}</h3>
                <p class="caption">{app.story}</p>
              </div>
            </div>
          </div>
        </div>
      </li>
    ))}
  </ul>
  <p>
    <a href={url("applications")}>{applicationsHome.linkText}</a>
  </p>
</div>

<style>
  .apps > * + * {
    margin-block-start: var(--s-5);
  }

  .apps__grid {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: 1fr;
    gap: var(--s-5);
  }

  .apps__grid > li {
    min-width: 0;
  }

  .apps__item--wide-only {
    display: none;
  }

  .apps__media {
    display: grid;
    gap: 1px;
    background: var(--edge);
  }

  .apps__media img {
    width: 100%;
    height: 100%;
    aspect-ratio: 1.618 / 1;
    object-fit: cover;
  }

  .apps__text {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-4) var(--s-4) var(--s-5);
  }

  @media (min-width: 600px) {
    .apps__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .apps__item--wide-only {
      display: block;
    }
  }

  @media (min-width: 900px) {
    .apps__body {
      flex-direction: row;
    }

    .apps__media {
      flex: 0 0 38%;
      align-content: start;
    }
  }
</style>
