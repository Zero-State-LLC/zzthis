---
import Card from "./Card.astro";
import Series from "./Series.astro";
import ConceptLabel from "./ConceptLabel.astro";
import { images } from "../content/images";
import { photoToAction } from "../content/workflows";

interface Props {
  headingLevel?: 3 | 4;
  showConceptLabel?: boolean;
}

const { headingLevel = 3, showConceptLabel = true } = Astro.props;
---

<div class="pta">
  <p>{photoToAction.intro}</p>
  {showConceptLabel && <ConceptLabel />}
  <ol class="pta__sequence" aria-label={photoToAction.sequenceLabel}>
    {photoToAction.sequence.map((step) => (
      <li>
        <Card
          image={step.image}
          title={step.title}
          caption={images[step.image].caption}
          numeral={step.numeral}
          headingLevel={headingLevel}
        />
      </li>
    ))}
  </ol>
  <Series columns="2">
    {photoToAction.cards.map((card) => (
      <li>
        <Card
          image={card.image}
          title={card.title}
          caption={images[card.image].caption}
          headingLevel={headingLevel}
        />
      </li>
    ))}
  </Series>
  <p>{photoToAction.workflow}</p>
</div>

<style>
  .pta > * + * {
    margin-block-start: var(--s-5);
  }

  .pta__sequence {
    position: relative;
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: 1fr;
    gap: var(--s-5);
    padding-left: var(--s-5);
  }

  .pta__sequence::before {
    content: "";
    position: absolute;
    left: 2.5px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--edge);
  }

  .pta__sequence > li {
    position: relative;
    min-width: 0;
  }

  .pta__sequence > li::before {
    content: "";
    position: absolute;
    left: calc(-1 * var(--s-5));
    top: var(--s-4);
    width: 6px;
    height: 6px;
    background: var(--accent);
  }

  .pta__sequence :global(.card__title) {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  @media (min-width: 900px) {
    .pta > .pta__sequence {
      margin-block-start: var(--s-6);
    }

    .pta__sequence {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      padding-left: 0;
      padding-top: var(--s-5);
    }

    .pta__sequence::before {
      left: 0;
      right: 0;
      top: 2.5px;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .pta__sequence > li::before {
      left: var(--s-4);
      top: calc(-1 * var(--s-5));
    }
  }
</style>
