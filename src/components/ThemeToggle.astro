<button class="theme" type="button" data-theme-toggle aria-label="Switch theme">
  <svg viewBox="0 0 20 20" aria-hidden="true">
    <circle cx="10" cy="10" r="7.5"></circle>
    <path d="M10 2.5a7.5 7.5 0 0 1 0 15z"></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const button = document.querySelector("[data-theme-toggle]");
    if (!(button instanceof HTMLButtonElement)) return;
    const root = document.documentElement;
    const media = matchMedia("(prefers-color-scheme: dark)");
    // [MICHAEL 2026-10-07] Every page starts dark (data-theme="dark" on <html>).
    // No storage (check-dist bans it), so the toggle applies to the current page.
    const isDark = () =>
      root.dataset.theme ? root.dataset.theme === "dark" : media.matches;
    const label = () => {
      button.setAttribute(
        "aria-label",
        isDark() ? "Switch to light theme" : "Switch to dark theme",
      );
    };
    label();
    button.addEventListener("click", () => {
      root.dataset.theme = isDark() ? "light" : "dark";
      label();
      document.dispatchEvent(new Event("themechange"));
    });
    media.addEventListener("change", label);
  })();
</script>
