---
import Card from "./Card.astro";
import { coreIdentity } from "../content/workflows";
import { images } from "../content/images";
import { url } from "../lib/url";
import ConceptLabel from "./ConceptLabel.astro";
import { conceptLabels } from "../content/labels";

interface Props {
  headingLevel?: 3 | 4;
  showConceptLabel?: boolean;
}

const { headingLevel = 3, showConceptLabel = false } = Astro.props;
---

<div class="steps">
  <p class="steps__example">
    {`${coreIdentity.exampleLabel}: `}
    <span class="code">{coreIdentity.exampleCode}</span>
  </p>
  {showConceptLabel && <ConceptLabel text={conceptLabels.group} />}
  <ol class="steps__list">
    {coreIdentity.steps.map((step) => (
      <li>
        <Card
          image={images[step.image]}
          title={step.title}
          caption={step.text}
          numeral={step.numeral}
          headingLevel={headingLevel}
        />
      </li>
    ))}
  </ol>
  <p>{coreIdentity.closing}</p>
  <p>
    <a href={url("demo")}>{coreIdentity.demoLinkText}</a>
  </p>
</div>

<style>
  .steps > * + * {
    margin-block-start: var(--s-4);
  }

  .steps__list {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: 1fr;
    gap: var(--s-5);
    margin-block-end: var(--s-5);
  }

  .steps__list > li {
    min-width: 0;
  }

  @media (min-width: 600px) {
    .steps__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1200px) {
    .steps__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
