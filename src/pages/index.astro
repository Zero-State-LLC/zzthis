---
import Anatomy from "../components/Anatomy.astro";
import AppIndex from "../components/AppIndex.astro";
import Architecture from "../components/Architecture.astro";
import Console from "../components/Console.astro";
import FieldFrames from "../components/FieldFrames.astro";
import Manifest from "../components/Manifest.astro";
import Pipeline from "../components/Pipeline.astro";
import ComparisonCards from "../components/ComparisonCards.astro";
import { comparisonHeading } from "../content/comparison";
import Tour from "../components/Tour.astro";
import { aboutTeaser, contactAction, hero } from "../content/hero";
import { contactEmail } from "../content/navigation";
import { url } from "../lib/url";
import BaseLayout from "../layouts/BaseLayout.astro";

const splitAt = hero.title.indexOf(". ");
const setup = hero.title.slice(0, splitAt + 1);
const claim = hero.title.slice(splitAt + 2);
const phrase = "readable-writable";
const phraseAt = claim.indexOf(phrase);
const claimBefore = claim.slice(0, phraseAt);
const claimAfter = claim.slice(phraseAt + phrase.length);
---

<BaseLayout title="zzThis" description={hero.subline} home>
  <section class="hero" id="top" aria-labelledby="hero-title">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">
        <span class="hero__setup">{setup}</span>{" "}
        <span class="hero__claim">
          {claimBefore}
          <span class="nowrap">{phrase}</span>
          {claimAfter}
        </span>
      </h1>
      <p class="hero__sub">{hero.subline}</p>
      <div class="hero__actions">
        {hero.actions.map((action) => (
          <a
            class:list={["btn", `btn--${action.variant}`]}
            href={url(action.path)}
          >
            {action.label}
          </a>
        ))}
      </div>
      <p class="hero__body">
        {hero.paragraph.before}
        <code>{hero.paragraph.code}</code>
        {hero.paragraph.after}
      </p>
    </div>
    <Console />
  </section>
  <Anatomy />
  <section class="compare" aria-labelledby="compare-title">
    <h2 id="compare-title">{comparisonHeading}</h2>
    <ComparisonCards />
  </section>
  <Tour />
  <Manifest />
  <FieldFrames />
  <Pipeline />
  <Architecture />
  <AppIndex />
  <section class="end" aria-label="About and contact">
    <div id="about">
      <h2>{aboutTeaser.heading}</h2>
      <p>{aboutTeaser.text}</p>
      <p>
        <a class="arrow" href={url("about")}>
          {aboutTeaser.linkText}
        </a>
      </p>
    </div>
    <div id="contact" class="end__contact">
      <h2>{contactAction.heading}</h2>
      <p>{contactAction.text}</p>
      <a class="mail" href={`mailto:${contactEmail}`}>
        {contactEmail}
      </a>
    </div>
  </section>
</BaseLayout>
