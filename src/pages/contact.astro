---
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactPage, mailto } from "../content/contact";
import { contactEmail } from "../content/navigation";
---

<BaseLayout
  title="Contact | zzThis"
  description={contactPage.text}
  current="contact"
>
  <div class="container contact">
    <div class="contact__text">
      <span class="regmark" aria-hidden="true"></span>
      <h1>{contactPage.title}</h1>
      <p class="contact__lead">{contactPage.text}</p>
    </div>
    <div class="mount mount--accent">
      <div class="mount__shadow" aria-hidden="true"></div>
      <div class="mount__edge">
        <div class="mount__body contact__card">
          <p>
            <a class="code email" href={mailto}>
              {contactEmail}
            </a>
          </p>
          <p class="caption">{contactPage.location}</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
    padding-block: var(--s-7);
  }

  .contact__text {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .contact__lead {
    font-size: var(--fs-h3);
    line-height: 1.4;
    color: var(--text-muted);
  }

  .contact__card {
    gap: var(--s-4);
    padding: var(--s-5) var(--s-5) var(--s-6);
  }

  .email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--fs-h2);
  }

  @media (min-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1.618fr) minmax(0, 1fr);
      align-items: end;
      padding-block: var(--s-8);
    }
  }
</style>
