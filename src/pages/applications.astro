---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import ConceptLabel from "../components/ConceptLabel.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Series from "../components/Series.astro";
import { applications, applicationsPage } from "../content/applications";
import { images } from "../content/images";
import { conceptLabels } from "../content/labels";

const columnsFor = (count: number): "2" | "3" => (count > 2 ? "3" : "2");
---

<BaseLayout
  title="Applications | zzThis"
  description={applicationsPage.intro}
  current="applications"
>
  <div class="container">
    <header class="page-head">
      <h1>{applicationsPage.title}</h1>
      <p>{applicationsPage.intro}</p>
      <ConceptLabel />
    </header>

    {applications.map((app, index) => (
      <section class="section" id={app.id}>
        <Eyebrow index={String(index + 1).padStart(2, "0")} />
        <h2>{app.title}</h2>
        <p>{app.story}</p>
        {app.pageExtra && <p>{app.pageExtra}</p>}
        <Series columns={columnsFor(app.pageImages.length)}>
          {app.pageImages.map((id) => (
            <li>
              <Card
                image={id}
                title={images[id].title}
                caption={images[id].caption}
                conceptTag={app.pageImages.length === 1}
              />
            </li>
          ))}
        </Series>
        {app.pageGalleries?.map((gallery) => {
          const metas = gallery.items.map((item) => images[item.image]);
          const allReal = metas.every((meta) => meta.status === "real-photo");
          const anyConcept = metas.some((meta) => meta.status === "concept");
          return (
            <div class="gallery">
              {gallery.heading && <h3>{gallery.heading}</h3>}
              {gallery.intro?.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {gallery.label === "group" && anyConcept && (
                <ConceptLabel text={conceptLabels.group} />
              )}
              {allReal && <p class="caption">Real photos.</p>}
              {gallery.lead && (
                <Series columns="2">
                  <li>
                    <Card
                      image={gallery.lead}
                      title={images[gallery.lead].title}
                      caption={images[gallery.lead].caption}
                      headingLevel={gallery.heading ? 4 : 3}
                      frame={`${images[gallery.lead].width} / ${images[gallery.lead].height}`}
                    />
                  </li>
                </Series>
              )}
              <Series columns={gallery.columns} ordered={gallery.ordered}>
                {gallery.items.map((item) => (
                  <li>
                    <Card
                      image={item.image}
                      title={item.title ?? images[item.image].title}
                      caption={images[item.image].caption}
                      headingLevel={gallery.heading ? 4 : 3}
                      frame={gallery.frame}
                      numeral={item.numeral}
                      conceptTag={gallery.label === "standalone"}
                    />
                  </li>
                ))}
              </Series>
              {gallery.closing?.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          );
        })}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding-block-start: var(--s-6);
  }

  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  @media (min-width: 900px) {
    .page-head {
      padding-block-start: var(--s-7);
    }
  }
</style>
