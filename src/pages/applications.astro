---
import AppSection from "../components/AppSection.astro";
import { applications, applicationsPage } from "../content/applications";
import { conceptLabels } from "../content/labels";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Applications | zzThis"
  description={applicationsPage.intro}
  current="applications"
>
  <section class="page-head" aria-labelledby="apps-page-title">
    <div class="page-head__copy">
      <h1 id="apps-page-title">{applicationsPage.title}</h1>
      <p class="page-head__lede">{applicationsPage.intro}</p>
      <p class="label">{conceptLabels.page}</p>
    </div>
    <nav aria-label="Applications on this page">
      <ul class="jump">
        {applications.map((app) => (
          <li>
            <a href={`#${app.id}`}>{app.title}</a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
  {applications.map((app) => (
    <AppSection app={app} />
  ))}
</BaseLayout>
