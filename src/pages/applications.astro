---
import AppSection from "../components/AppSection.astro";
import Walkthroughs from "../components/Walkthroughs.astro";
import { applications, applicationsPage } from "../content/applications";
import { walkthroughs } from "../content/walkthroughs";
import BaseLayout from "../layouts/BaseLayout.astro";

// [MICHAEL 2026-10-11] The two walkthroughs sit between Field logistics and
// Postal and parcel, and get their own jump links in the same place.
const WALKTHROUGHS_AFTER = "field";
interface Jump {
  id: string;
  title: string;
}
const jumps: Jump[] = applications.flatMap((app): Jump[] =>
  app.id === WALKTHROUGHS_AFTER
    ? [
        { id: app.id, title: app.title },
        ...walkthroughs.map((walk) => ({ id: walk.id, title: walk.title })),
      ]
    : [{ id: app.id, title: app.title }],
);
---

<BaseLayout
  title="Applications | zzThis"
  description={applicationsPage.description}
  current="applications"
>
  <section class="page-head" aria-labelledby="apps-page-title">
    <div class="page-head__copy">
      <h1 id="apps-page-title">{applicationsPage.title}</h1>
    </div>
    <nav aria-label="Applications on this page">
      <ul class="jump">
        {jumps.map((jump) => (
          <li>
            <a href={`#${jump.id}`}>{jump.title}</a>
          </li>
        ))}
      </ul>
    </nav>
  </section>
  {applications.map((app) => (
    <Fragment>
      <AppSection app={app} />
      {app.id === WALKTHROUGHS_AFTER && <Walkthroughs />}
    </Fragment>
  ))}
</BaseLayout>
