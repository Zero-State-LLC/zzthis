---
import PersonCard from "../components/PersonCard.astro";
import { aboutPage, hackerDojo, mailto, prototypes } from "../content/contact";
import { images } from "../content/images";
import { contactEmail } from "../content/navigation";
import { advisors, founder, peopleHeadings } from "../content/people";
import { url } from "../lib/url";
import BaseLayout from "../layouts/BaseLayout.astro";

const handwritten = [
  images["hw-agent-notes"],
  images["hw-usps-tally"],
  images["hw-mark-on-object"],
  images["hw-dog-collar-tag"],
] as const;
---

<BaseLayout title="About zzThis" description={aboutPage.intro} current="about">
  <section class="page-head page-head--about" aria-labelledby="about-title">
    <div class="page-head__copy">
      <h1 id="about-title">{aboutPage.title}</h1>
      <p class="page-head__lede">{aboutPage.intro}</p>
    </div>
    <aside class="contact-card" aria-label={aboutPage.contactCardHeading}>
      <p class="label">{aboutPage.contactCardHeading}</p>
      <a class="mail" href={mailto}>
        {contactEmail}
      </a>
      <p>{aboutPage.contactCardText}</p>
    </aside>
  </section>

  <section class="block" aria-labelledby="explore-title">
    <h2 id="explore-title">{aboutPage.explorationsHeading}</h2>
    <p class="label">{aboutPage.prototypeLabel}</p>
    <ul class="explore">
      {prototypes.map((site) => (
        <li>
          <a href={site.href}>{site.name}</a>
          {site.logo?.srcLight && (
            <img
              class="explore__logo only-light"
              src={url(site.logo.srcLight)}
              width={site.logo.width}
              height={site.logo.height}
              alt={site.logo.alt}
              loading="lazy"
              decoding="async"
            />
          )}
          {site.logo && (
            <img
              class:list={[
                "explore__logo",
                { "only-dark": site.logo.srcLight !== undefined },
              ]}
              src={url(site.logo.src)}
              width={site.logo.width}
              height={site.logo.height}
              alt={site.logo.alt}
              loading="lazy"
              decoding="async"
            />
          )}
          <p>{site.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="block" aria-labelledby="founder-title">
    <h2 id="founder-title">{peopleHeadings.founder}</h2>
    <ul class="people">
      <li class="person--wide">
        <PersonCard person={founder} />
      </li>
    </ul>
  </section>

  <section class="block" aria-labelledby="advisors-title">
    <h2 id="advisors-title">{peopleHeadings.advisors}</h2>
    <ul class="people">
      {advisors.map((person) => (
        <li>
          <PersonCard person={person} />
        </li>
      ))}
    </ul>
  </section>

  <section class="block dojo" aria-labelledby="dojo-title">
    <div class="dojo__head">
      <h2 id="dojo-title">{hackerDojo.heading}</h2>
      <p class="dojo__sub">{hackerDojo.subtitle}</p>
    </div>
    {hackerDojo.paragraphs.map((paragraph) => (
      <p>{paragraph}</p>
    ))}
  </section>

  <section class="block" aria-labelledby="hw-title">
    <h2 id="hw-title">{aboutPage.handwrittenHeading}</h2>
    <p class="label">{aboutPage.handwrittenLabel}</p>
    <ul class="hw">
      {handwritten.map((photo) => (
        <li>
          <figure>
            <img
              src={url(photo.src)}
              width={photo.width}
              height={photo.height}
              alt={photo.alt}
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <code>{photo.title}</code>
              {photo.caption}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>

  <section class="where" aria-label="Location and next action">
    <div>
      <h2>{aboutPage.locationHeading}</h2>
      <p>{aboutPage.locationText}</p>
    </div>
    <div>
      <h2>{aboutPage.nextHeading}</h2>
      <p>
        <a href={mailto}>{aboutPage.nextText}</a>
      </p>
    </div>
  </section>
</BaseLayout>
