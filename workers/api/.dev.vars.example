# Local values for npm run dev:api (spec 005 Environment, Local values).
# Names and local test values only: every secret is empty here. The dev
# script copies this file to the git-ignored .dev.vars and fills the three
# secrets with values generated on this machine. There are no APPLE_* or
# GOOGLE_* names, so discovery lists only dev.
ZZ_ENV=local
ZZ_CONTRACT=1
ZZ_DEV_AUTH=true
ZZ_FREE_PUBLIC=true
ZZ_MINT_ENABLED=true
ZZ_WORDLIST_VERSION=fixture-7
ZZ_PHOTO_READS=false
ZZ_RECORD_SIGNING_KEY_ID=local-1
ZZ_BLOCKLIST=
ZZ_TOKEN_SECRET=
ZZ_DATA_KEY=
ZZ_RECORD_SIGNING_KEY=
