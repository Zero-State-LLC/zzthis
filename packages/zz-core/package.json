{
  "name": "@zzthis/zz-core",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "lint": "npm run wordlists:module",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "wordlist:build": "node scripts/build-wordlist.ts",
    "wordlists:module": "node scripts/build-wordlists-module.ts && git diff --exit-code src/generated/"
  }
}
