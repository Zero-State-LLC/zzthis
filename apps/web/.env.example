# Public build settings for the web client (spec 005 Web client, Build
# settings). Not secrets. A release build gets them injected; a local build
# leaves them empty, so /signin/ shows only the developer sign-in.
PUBLIC_GOOGLE_WEB_CLIENT_ID=
PUBLIC_APPLE_SERVICES_ID=
PUBLIC_APPLE_REDIRECT_URI=
PUBLIC_SUPPORT_EMAIL=
PUBLIC_PRIVACY_URL=
