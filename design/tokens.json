    "--mask-solid": {
      "light": "oklch(0% 0 0)",
      "dark": "oklch(0% 0 0)"
    },
    "--color-dither-dark": {
      "light": "oklch(17.5% 0.006 75)",
      "dark": "oklch(17.5% 0.006 75)"
    },
    "--color-dither-light": {
      "light": "oklch(80% 0.12 55)",
      "dark": "oklch(80% 0.12 55)"
    }
  },
  "type": {
    "font": {
      "--font-display": "\"IBM Plex Sans Condensed\", \"Arial Narrow\", sans-serif",
      "--font-body": "\"IBM Plex Sans\", system-ui, sans-serif",
      "--font-mono": "\"IBM Plex Mono\", \"IBM Plex Sans KR\", \"IBM Plex Sans JP\", \"IBM Plex Sans Hebrew\", ui-monospace, monospace"
    },
    "size": {
      "--text-2xs": "0.75rem",
      "--text-xs": "0.8125rem",
      "--text-sm": "0.9375rem",
      "--text-base": "1.0625rem",
      "--text-md": "1.25rem",
      "--text-lg": "1.5625rem",
      "--text-xl": "clamp(1.75rem, 1.6vw + 1.1rem, 2.4rem)",
      "--text-display-s": "clamp(2rem, 2.4vw + 1.1rem, 3.4rem)",
      "--text-code": "clamp(1rem, 2.75vw, 2.3rem)"
    },
    "weight": [
      400,
      500,
      600,
      700
    ],
    "lineHeight": "1.6"
  },
  "spacing": {
    "--space-3xs": "4px",
    "--space-2xs": "6px",
    "--space-xs": "10px",
    "--space-sm": "16px",
    "--space-md": "26px",
    "--space-lg": "42px",
    "--space-xl": "68px",
    "--space-2xl": "110px"
  },
  "radius": {
    "--radius-none": "0",
    "--radius-chip": "3px",
    "pill": "999px"
  },
  "shadow": {
    "color": {
      "light": "rgb(28 27 25 / 0.12)",
      "dark": "rgb(0 0 0 / 0.35)"
    },
    "mount": {
      "top": "8px",
      "bottom": "-8px",
      "left": "4%",
      "right": "4%",
      "blur": "10px",
      "source": "src/styles/base.css"
    }
  },
  "motion": {
    "--ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
    "--ease-in": "cubic-bezier(0.7, 0, 0.84, 0)",
    "--ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
    "--dur-micro": "120ms",
    "--dur-short": "220ms",
    "--dur-long": "420ms"
  },
  "layout": {
    "--gutter": "16px",
    "--max": "1280px",
    "--measure": "62ch",
    "--rule-hair": "1px",
    "--grid-cell": "24px",
    "--nav-h": "64px",
    "--cut": "16px",
    "--fs-mono": "1rem",
    "gutterBreakpoints": {
      "40rem": "26px",
      "60rem": "42px"
    }
  },
  "z": {
    "--z-base": "1",
    "--z-overlay": "2",
    "--z-sticky": "10",
    "--z-menu": "20"
  },
  "legacy": {
    "--text-section": "calc(var(--text-display-s) * 0.75)",
    "--text-h2": "calc(var(--text-xl) * 0.75)",
    "--text-sub": "max(var(--text-base), calc(var(--text-md) * 0.75))",
    "--surface": "var(--color-paper)",
    "--mount": "var(--color-panel)",
    "--text": "var(--color-ink)",
    "--text-muted": "var(--color-ink-2)",
    "--edge": "var(--color-rule)",
    "--accent": "var(--color-accent)",
    "--on-accent": "var(--color-on-accent)",
    "--s-1": "var(--space-3xs)",
    "--s-2": "var(--space-2xs)",
    "--s-3": "var(--space-xs)",
    "--s-4": "var(--space-sm)",
    "--s-5": "var(--space-md)",
    "--s-6": "var(--space-lg)",
    "--s-7": "var(--space-xl)",
    "--s-8": "var(--space-2xl)",
    "--section-gap": "var(--space-xl)",
    "--font-sans": "var(--font-body)",
    "--fs-h1": "var(--text-section)",
    "--fs-h2": "var(--text-h2)",
    "--fs-h3": "var(--text-sub)",
    "--fs-body": "var(--text-base)",
    "--fs-caption": "var(--text-xs)",
    "--fs-label": "var(--text-2xs)"
  }
}
