    },
    "--color-panel-2": {
      "light": "oklch(91.7% 0.021 86)",
      "dark": "oklch(25.5% 0.008 75)"
    },
    "--color-ink": {
      "light": "oklch(22.2% 0.004 85)",
      "dark": "oklch(94% 0.014 86)"
    },
    "--color-ink-2": {
      "light": "oklch(39.6% 0.013 82)",
      "dark": "oklch(78% 0.018 85)"
    },
    "--color-ink-3": {
      "light": "oklch(46% 0.012 82)",
      "dark": "oklch(70% 0.014 85)"
    },
    "--color-rule": {
      "light": "oklch(82.9% 0.027 85)",
      "dark": "oklch(32% 0.009 80)"
    },
    "--color-rule-strong": {
      "light": "oklch(60% 0.02 85)",
      "dark": "oklch(53% 0.012 80)"
    },
    "--color-grid": {
      "light": "oklch(90% 0.02 86)",
      "dark": "oklch(21% 0.007 75)"
    },
    "--color-accent": {
      "light": "oklch(65.9% 0.215 38)",
      "dark": "oklch(65.9% 0.215 38)"
    },
    "--color-on-accent": {
      "light": "oklch(22.2% 0.004 85)",
      "dark": "oklch(22.2% 0.004 85)"
    },
    "--color-accent-ink": {
      "light": "oklch(45% 0.165 38)",
      "dark": "oklch(73% 0.17 42)"
