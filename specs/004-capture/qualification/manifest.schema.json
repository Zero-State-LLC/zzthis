{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zer0state.com/schemas/zz-ocr-qual-manifest-v1.json",
  "title": "ZZ-OCR-QUAL-001 corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "qualification_id", "samples"],
  "properties": {
    "schema_version": { "const": 1 },
    "qualification_id": { "const": "ZZ-OCR-QUAL-001" },
    "samples": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/sample" }
    }
  },
  "$defs": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "polygon": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/point" }
    },
    "fiducial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "role", "box"],
      "properties": {
        "pair_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["opening", "closing"] },
        "box": { "$ref": "#/$defs/box" }
      }
    },
    "roiTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "polygon"],
      "properties": {
        "pair_id": { "type": "string", "minLength": 1 },
        "polygon": { "$ref": "#/$defs/polygon" }
      }
    },
    "groundTruthCode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pair_id", "literal_payload", "canonical_code", "kind"],
      "properties": {
        "pair_id": { "type": "string", "minLength": 1 },
        "literal_payload": { "type": "string" },
        "canonical_code": { "type": ["string", "null"] },
        "kind": { "enum": ["valid", "partial", "invalid"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "valid" } },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "canonical_code": { "type": "string", "minLength": 1 }
            }
          },
          "else": { "properties": { "canonical_code": { "const": null } } }
        }
      ]
    },
    "stressBucket": {
      "enum": [
        "clean",
        "single-code",
        "handwriting",
        "print",
        "low-contrast",
        "glare",
        "blur",
        "motion-blur",
        "perspective",
        "rotation",
        "distance",
        "wrapped",
        "multi-code",
        "partial-fiducial",
        "false-zz",
        "ambiguous-pairing",
        "unequal-fiducial-size",
        "curved-surface",
        "candidate-overflow",
        "running-text",
        "confusable-character",
        "near-word",
        "invalid-reserved-character",
        "no-code",
        "handle",
        "field-code-part"
      ]
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "split",
        "asset_sha256",
        "consent_class",
        "writer_group",
        "device_class",
        "case_kind",
        "stress_tags",
        "ground_truth_codes",
        "fiducials",
        "roi_truth"
      ],
      "properties": {
        "sample_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "split": { "enum": ["tuning", "final"] },
        "asset_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "consent_class": {
          "enum": ["team-made", "synthetic", "separately-approved"]
        },
        "writer_group": { "type": "string", "minLength": 1 },
        "device_class": { "type": "string", "minLength": 1 },
        "case_kind": {
          "enum": [
            "valid-word",
            "field",
            "handle",
            "partial",
            "bare",
            "invalid",
            "multi-code",
            "no-code"
          ]
        },
        "stress_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stressBucket" }
        },
        "ground_truth_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/groundTruthCode" }
        },
        "fiducials": {
          "type": "array",
          "items": { "$ref": "#/$defs/fiducial" }
        },
        "roi_truth": {
          "type": "array",
          "items": { "$ref": "#/$defs/roiTruth" }
        },
        "expected_band_constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["accept", "clarify", "retry", "abstain"] }
        },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "case_kind": {
                "enum": [
                  "valid-word",
                  "field",
                  "handle",
                  "invalid",
                  "multi-code"
                ]
              }
            },
            "required": ["case_kind"]
          },
          "then": {
            "properties": {
              "ground_truth_codes": { "minItems": 1 },
              "roi_truth": { "minItems": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "case_kind": { "const": "multi-code" } },
            "required": ["case_kind"]
          },
          "then": { "properties": { "ground_truth_codes": { "minItems": 2 } } }
        },
        {
          "if": {
            "properties": {
              "case_kind": { "enum": ["partial", "invalid"] }
            },
            "required": ["case_kind"]
          },
          "then": { "properties": { "ground_truth_codes": { "minItems": 1 } } }
        },
        {
          "if": {
            "properties": { "case_kind": { "enum": ["bare", "no-code"] } },
            "required": ["case_kind"]
          },
          "then": { "properties": { "ground_truth_codes": { "maxItems": 0 } } }
        }
      ]
    }
  }
}
